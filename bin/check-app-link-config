#!/bin/sh
# Checks app-links.json parsing, validation, ordering, writing, matching, and
# the file store (load, save, migrate, reload on change) against temp files.
# Usage: bin/check-app-link-config
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
build=$(mktemp -d)
trap 'rm -rf "$build"' EXIT
: "${DEVELOPER_DIR:=/Applications/Xcode.app/Contents/Developer}"
export DEVELOPER_DIR
# Top-level statements are only allowed in a file named main.swift.
cp "$root/bin/check-app-link-config.swift" "$build/main.swift"
xcrun swiftc -o "$build/check" \
    "$root/PerSpaceLinkRouter/AppLinkRule.swift" \
    "$root/PerSpaceLinkRouter/AppLinkConfig.swift" \
    "$root/PerSpaceLinkRouter/AppLinkConfigStore.swift" \
    "$build/main.swift"
"$build/check" "$build"
